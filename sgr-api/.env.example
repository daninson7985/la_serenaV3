# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# Clave propia de esta API (distinta a la del SGR). Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REEMPLAZA_POR_UNA_CLAVE_ALEATORIA_LARGA
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Base de datos del SGR (solo lectura) ----
# sqlite: ruta al db.sqlite3 del SGR. mysql: base del SGR en MariaDB/MySQL.
SGR_DB_ENGINE=sqlite
SGR_DB_NAME=../BackEnd3-main/backend/db.sqlite3
# Solo para mysql. Usa un usuario con permiso SELECT únicamente (ver README).
SGR_DB_USER=
SGR_DB_PASSWORD=
SGR_DB_HOST=127.0.0.1
SGR_DB_PORT=3306

# ---- Base propia de la API (solo tokens e intentos de acceso) ----
API_DB_NAME=api.sqlite3

# ---- Tokens y acceso ----
# Horas de validez de cada token.
API_TOKEN_HORAS=8
# Intentos fallidos de inicio de sesión antes de bloquear el usuario.
API_MAX_INTENTOS=5
# Minutos de bloqueo tras superar los intentos.
API_BLOQUEO_MINUTOS=15

# Orígenes web que pueden llamar a la API desde el navegador (frontend), separados por coma.
CORS_ALLOWED_ORIGINS=

# Producción con HTTPS (Nginx delante): True.
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL_HEADER=False
